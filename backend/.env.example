# =============================================================================
# EchoShield backend configuration (local development)
# =============================================================================

APP_NAME=echoshield-backend
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- THREDDS / scientific services -----------------------------------------
#THREDDS_BASE_URL=http://localhost:8080/thredds
#THREDDS_CATALOG_URL=http://localhost:8080/thredds/catalog.xml
#OPENDAP_BASE_URL=http://localhost:8080/thredds
#WMS_BASE_URL=http://localhost:8080/thredds
#WCS_BASE_URL=
INCOIS_ERDDAP_URL=https://erddap.incois.gov.in/erddap

# --- Argo -------------------------------------------------------------------
ARGO_SOURCE=erddap
ARGO_DATASET=phy

# --- Glider -----------------------------------------------------------------
# Real ERDDAP tabledap endpoint ending in the dataset id, e.g.
# GLIDER_DATA_URL=https://example.org/erddap/tabledap/my_glider_dataset
# The adapter accepts common aliases: mission_id/glider_id/platform,
# latitude/lat, longitude/lon, time, depth, temperature, salinity, chlorophyll.
# Leave empty to keep the explicit not-configured behavior.
GLIDER_DATA_URL=

# --- Data locations ---------------------------------------------------------
DATA_ROOT=../data
NETCDF_DATA_ROOT=
ARGO_CACHE_DIR=
GLIDER_CACHE_DIR=

# --- Reliability / limits ---------------------------------------------------
REQUEST_TIMEOUT=30
MAX_DATA_POINTS=200000
MAX_PROFILE_POINTS=500
MAX_GRID_POINTS=100000
CACHE_TTL_SECONDS=3600
