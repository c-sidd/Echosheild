# =============================================================================
# EchoShield backend configuration (local development)
#
# Copy to backend/.env (or repository-root .env) and adjust per environment.
# Precedence: real environment variables > backend/.env > ../.env
# NEVER commit a real .env.
#
# Inside docker compose use service names (http://thredds:8080/thredds),
# NOT localhost - see /infra/docker-compose.yml and /.env.example.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=echoshield-backend
APP_ENV=development              # development | staging | production
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed browser origins (frontend dev server etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- THREDDS / scientific services ---------------------------------------------
# Local dev without the THREDDS container: leave unset or point at a running
# instance. Never hardcode these in application code.
#THREDDS_BASE_URL=http://localhost:8080/thredds
#THREDDS_CATALOG_URL=http://localhost:8080/thredds/catalog.xml
#OPENDAP_BASE_URL=http://localhost:8080/thredds
#WMS_BASE_URL=http://localhost:8080/thredds
# WCS is only advertised when an external WCS-capable service is configured.
#WCS_BASE_URL=

# INCOIS ERDDAP (real public endpoint; griddap doubles as an OPeNDAP flavour)
INCOIS_ERDDAP_URL=https://erddap.incois.gov.in/erddap

# --- Argo ingestion --------------------------------------------------------------
ARGO_SOURCE=erddap               # erddap | gdac
ARGO_DATASET=phy                 # phy | bgc ...
# Provider: auto prefers local profile files in ARGO_CACHE_DIR when present.
#ARGO_PROVIDER=auto
# argopy upstream HTTP timeout in seconds — Ifremer ERDDAP bulk-region
# queries for the Indian Ocean can exceed the 60 s default.
#ARGO_API_TIMEOUT=120
# Override the upstream server (empty -> argopy built-in Ifremer defaults).
#ARGO_ERDDAP_URL=
#ARGO_GDAC_URL=

# --- Glider ingestion (future) ----------------------------------------------------
# Set when a real glider source exists; until then the glider API reports
# "not configured" and never fabricates data.
GLIDER_DATA_URL=

# --- Data locations ---------------------------------------------------------------
# Defaults resolve to <repo>/data when unset; set absolute paths in containers.
DATA_ROOT=../data
NETCDF_DATA_ROOT=
ARGO_CACHE_DIR=
GLIDER_CACHE_DIR=

# --- Reliability / limits -----------------------------------------------------------
REQUEST_TIMEOUT=30
MAX_DATA_POINTS=200000
MAX_PROFILE_POINTS=500
MAX_GRID_POINTS=100000
CACHE_TTL_SECONDS=3600
