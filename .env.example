# =============================================================================
# EchoShield backend configuration
# Copy to `.env` (backend/ or repository root) and adjust per environment.
# NEVER commit real secrets.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=echoshield-backend
APP_ENV=development              # development | staging | production
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed browser origins (frontend dev server etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- THREDDS / scientific services ---------------------------------------------
# Inside docker compose use service names, NOT localhost:
THREDDS_BASE_URL=http://thredds:8080/thredds
THREDDS_CATALOG_URL=http://thredds:8080/thredds/catalog.xml
OPENDAP_BASE_URL=http://thredds:8080/thredds
WMS_BASE_URL=http://thredds:8080/thredds
# WCS is only advertised when an external WCS-capable service is configured.
WCS_BASE_URL=

# INCOIS ERDDAP (real public endpoint; griddap doubles as OPeNDAP flavour)
INCOIS_ERDDAP_URL=https://erddap.incois.gov.in/erddap

# --- Argo ingestion --------------------------------------------------------------
ARGO_SOURCE=erddap               # erddap | gdac (gdac downloads per-float files
                                 # sequentially and needs a large timeout)
ARGO_DATASET=phy                 # phy | bgc ...
ARGO_API_TIMEOUT=120             # argopy upstream timeout in seconds (default 120)
ARGO_ERDDAP_URL=                 # override argopy's erddap server (blank = Ifremer default)
ARGO_GDAC_URL=                   # override argopy's GDAC path (blank = data-argo.ifremer.fr)

# --- Glider ingestion (future) ----------------------------------------------------
# Set when a real glider source exists; until then the glider API reports
# "not configured" and never fabricates data.
GLIDER_DATA_URL=

# --- Data locations ---------------------------------------------------------------
# Local development defaults to <repo>/data; set absolute paths in containers.
DATA_ROOT=./data
NETCDF_DATA_ROOT=
ARGO_CACHE_DIR=
GLIDER_CACHE_DIR=

# --- Reliability / limits -----------------------------------------------------------
REQUEST_TIMEOUT=30
MAX_DATA_POINTS=200000
MAX_PROFILE_POINTS=500
MAX_GRID_POINTS=100000
CACHE_TTL_SECONDS=3600
